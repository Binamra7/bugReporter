{
    "name": "bug-reporter",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "next typegen && tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
        "db:up": "docker run -d --name bug-reporter-mongo -p 27017:27017 mongo:8",
        "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
        "db:down": "docker rm -f bug-reporter-mongo"
    },
    "engines": {
        "node": ">=20.9"
    },
    "dependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/schibsted-grotesk": "^5.3.0",
        "@vercel/functions": "^3.10.2",
        "mongodb": "^7.7.0",
        "next": "^16.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "server-only": "^0.0.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.2",
        "jsdom": "^29.1.1",
        "mongodb-memory-server": "^11.3.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0",
        "vitest": "^4.1.12"
    }
}
