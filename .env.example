# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# MongoDB connection string. Locally: `npm run db:up` starts mongo:8 in Docker on this port.
MONGODB_URI=mongodb://localhost:27017
# Database that holds the `bugs` collection. Optional: when unset, the database named in
# MONGODB_URI is used (MongoDB falls back to `test`, which is where the old Express API wrote).
MONGODB_DB=bug-reporter

# Password for the triage area (/triage). At least 12 characters; use a long random value in production.
ADMIN_PASSWORD=
# Signs the triage session cookie. At least 32 characters: `openssl rand -base64 32`.
SESSION_SECRET=
# Optional: "on" lets visitors browse /triage read-only as a guest. For public demos only.
GUEST_ACCESS=
